# =============================================================================
# Example: Project Findings
# =============================================================================

# List FINDINGS.md files for a tier: just project-findings-list t1
project-findings-list tier:
    #!/usr/bin/env bash
    case "{{tier}}" in t1) dir="work/tier1" ;; t2) dir="work/tier2" ;; t3) dir="work/tier3" ;; *) echo "Unknown tier: {{tier}}"; exit 1 ;; esac
    find "$dir" -name '*FINDING*' -name '*.md' | sort

# Summarize all findings for a tier: just project-findings-summarize t2
project-findings-summarize tier:
    #!/usr/bin/env bash
    case "{{tier}}" in t1) dir="work/tier1" ;; t2) dir="work/tier2" ;; t3) dir="work/tier3" ;; *) echo "Unknown tier: {{tier}}"; exit 1 ;; esac
    files=$(find "$dir" -name '*FINDING*' -name '*.md' ! -path '*/archive/*' | sort)
    if [ -z "$files" ]; then echo "No findings files found for {{tier}}"; exit 1; fi
    content=""
    for f in $files; do
        content+=$'\n=== FILE: '"$f"$' ===\n'
        content+="$(cat "$f")"
    done
    prompt='You are a digital forensics analyst. Summarize the investigation findings below into a concise briefing.
    For each findings file, output:
    - **File**: the filename
    - **Key findings**: 2-3 bullet points of the most important discoveries
    - **IOCs**: any IPs, domains, hashes, filenames mentioned
    - **Severity**: CRITICAL / HIGH / MEDIUM / LOW

    End with an OVERALL SUMMARY section that ties the findings together into a coherent attack narrative.
    Be factual - no speculation. Reference specific artifacts (frame numbers, timestamps, file paths) where available.'
    echo "$content" | claude -p --model haiku "$prompt"

