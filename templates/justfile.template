# PROJECT_NAME - Forensic Analysis Commands
# Generic forensic targets imported from gizur-arti

set allow-duplicate-recipes
set allow-duplicate-variables

import? '~/repos/gizur-arti/justfile'

# Setup environment for all bash scripts
export PATH := "/home/me/repos/gizur-arti/scripts:/home/me/repos/gizur-arti/.venv/bin:" + env_var('PATH')

# Default: list available recipes
default:
    @just --list

# Use mdcat for markdown if available, otherwise cat
md := if `which mdcat 2>/dev/null || echo ""` != "" { "mdcat" } else { "cat" }

